{
  "private": true,
  "scripts": {
    "format": "prettier --write \"src/**/*.java\" \"src/test/javascript/**/*.js\" \"src/test/e2e/**/*.js\" \"src/test/resources/**/*.mjs\" \"scripts/**/*.mjs\" \"src/main/editor/**/*.{js,mjs}\" src/main/editor/style.css eslint.config.mjs playwright.config.js",
    "format:check": "prettier --check \"src/**/*.java\" \"src/test/javascript/**/*.js\" \"src/test/e2e/**/*.js\" \"src/test/resources/**/*.mjs\" \"scripts/**/*.mjs\" \"src/main/editor/**/*.{js,mjs}\" src/main/editor/style.css eslint.config.mjs playwright.config.js",
    "prelint": "npm run editor:build",
    "lint": "node scripts/extract-editor-script.mjs && eslint --max-warnings 0 eslint.config.mjs playwright.config.js scripts src/test target/eslint-editor",
    "kernel:build": "bash src/main/rust/viewpoint-kernel/embed.sh",
    "editor:build": "npm run kernel:build && node scripts/build-editor.mjs && node scripts/build-sample.mjs",
    "editor:check": "node scripts/build-editor.mjs --check && node scripts/check-editor.mjs --layers",
    "sample:build": "node scripts/build-sample.mjs",
    "pretest:unit": "npm run editor:build",
    "test:unit": "node --test \"src/test/javascript/**/*.test.js\"",
    "test:e2e": "playwright test",
    "pretest:coverage": "npm run editor:build",
    "test:coverage": "node scripts/editor-coverage.mjs",
    "test:timing": "ARCHICODE_TIMING=1 node --test --test-name-pattern=\"#125: the first\" src/test/javascript/viewpoint-kernel/performance-budget.test.js"
  },
  "dependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-java": "^2.11.0"
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/lang-yaml": "6.1.1",
    "@codemirror/language": "6.13.1",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "codemirror": "6.0.1",
    "elkjs": "0.9.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-scope": "9.1.2",
    "globals": "17.12.0"
  }
}
