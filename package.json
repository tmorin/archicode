{
  "private": true,
  "scripts": {
    "format": "prettier --write \"src/**/*.java\" \"src/test/javascript/**/*.js\" \"src/test/e2e/**/*.js\" \"src/test/resources/**/*.mjs\" \"scripts/**/*.mjs\" \"src/main/editor/**/*.{js,mjs}\" eslint.config.mjs playwright.config.js",
    "format:check": "prettier --check \"src/**/*.java\" \"src/test/javascript/**/*.js\" \"src/test/e2e/**/*.js\" \"src/test/resources/**/*.mjs\" \"scripts/**/*.mjs\" \"src/main/editor/**/*.{js,mjs}\" eslint.config.mjs playwright.config.js",
    "prelint": "node scripts/build-editor.mjs",
    "lint": "node scripts/extract-editor-script.mjs && eslint --max-warnings 0 eslint.config.mjs playwright.config.js scripts src/test target/eslint-editor",
    "editor:build": "node scripts/build-editor.mjs",
    "editor:check": "node scripts/build-editor.mjs --check && node scripts/check-editor.mjs --layers",
    "pretest:unit": "node scripts/build-editor.mjs",
    "test:unit": "node --test \"src/test/javascript/**/*.test.js\"",
    "test:e2e": "playwright test",
    "pretest:coverage": "node scripts/build-editor.mjs",
    "test:coverage": "node scripts/editor-coverage.mjs",
    "test:timing": "ARCHICODE_TIMING=1 node --test --test-name-pattern=\"#125: the first\" src/test/javascript/viewpoint-kernel/performance-budget.test.js"
  },
  "dependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-java": "^2.11.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "eslint": "10.12.0",
    "eslint-scope": "9.1.2",
    "globals": "17.12.0"
  }
}
