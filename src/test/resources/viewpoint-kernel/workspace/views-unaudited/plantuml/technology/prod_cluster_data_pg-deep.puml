@startuml prod_cluster_data_pg-deep
title Node - database pod - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle prod as "**Production**\n""[environment]""" <<composite>> {
rectangle prod.cluster as "**Kubernetes Cluster**\n""[node: K8s]""" <<K8s>> <<composite>> {
rectangle prod.cluster.data as "**data namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.data.pg as "**database pod**\n""[node]""" <<composite>> {
rectangle pg_shop_catalog_db <<PostgreSQL>> <<container>> <<atomic>> [
**Catalog Database**
""[container: PostgreSQL]""
]
}
rectangle prod.cluster.data.svc as "**catalog pod**\n""[node]""" <<composite>> {
rectangle svc_shop_catalog_service <<Quarkus>> <<container>> <<atomic>> [
**Catalog Service**
""[container: Quarkus]""
]
}
}
}
}
svc_shop_catalog_service --> pg_shop_catalog_db : reads and writes\n""[JDBC]""
prod.cluster.data.svc --> prod.cluster.data.pg : ""[TCP:5432]""
<style>
.external {
actor {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
card {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
database {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
node {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
person {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
rectangle {
BackgroundColor: lightgray
}
}
</style>
@enduml
