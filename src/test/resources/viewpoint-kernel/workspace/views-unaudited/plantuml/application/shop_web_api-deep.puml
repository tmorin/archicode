@startuml shop_web_api-deep
title Container - API - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle mailer <<changed>> <<external>> <<system>> <<atomic>> [
**Mail Provider**
""[system]""

Sends the e-mails.
]
rectangle shop as "**Online Shop**\n""[solution]""" <<composite>> {
rectangle shop.catalog as "**Catalog**\n""[system]""" <<composite>> {
rectangle shop.catalog.service <<Quarkus>> <<container>> <<atomic>> [
**Catalog Service**
""[container: Quarkus]""
]
}
rectangle shop.web as "**Web Shop**\n""[system]""" <<composite>> {
rectangle shop.web.api <<Spring Boot>> <<container>> <<atomic>> [
**API**
""[container: Spring Boot]""
]
rectangle shop.web.edge as "**Edge**\n""[container]""" <<composite>> {
rectangle shop.web.edge.gateway <<Envoy>> <<component>> <<atomic>> [
**Gateway**
""[component: Envoy]""
]
}
rectangle shop.web.frontend <<Angular>> <<container>> <<atomic>> [
**Frontend**
""[container: Angular]""
]
rectangle shop.web.session <<Redis>> <<container>> <<atomic>> [
**Session Store**
""[container: Redis]""
]
}
}
shop.web.api --> mailer : notifies through\n""[SMTP]""
shop.web.api --> shop.catalog.service : queries\n""[gRPC]""
shop.web.api --> shop.web.session
shop.web.edge.gateway --> shop.web.api : routes to\n""[HTTP]""
shop.web.frontend --> shop.web.api : calls\n""[REST]""
<style>
.external {
actor {
BackgroundColor: lightgray
}
}
</style>
<style>
