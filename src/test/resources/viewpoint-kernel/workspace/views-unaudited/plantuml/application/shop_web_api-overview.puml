@startuml shop_web_api-overview
title Container - API - Overview
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle mailer <<changed>> <<external>> <<system>> <<atomic>> [
**Mail Provider**
""[system]""

Sends the e-mails.
]
rectangle shop as "**Online Shop**\n""[solution]""" <<composite>> {
rectangle shop.catalog <<system>> <<atomic>> [
**Catalog**
""[system]""

What is for sale.
]
rectangle shop.web as "**Web Shop**\n""[system]""" <<composite>> {
rectangle shop.web.api <<Spring Boot>> <<container>> <<atomic>> [
**API**
""[container: Spring Boot]""
]
rectangle shop.web.edge <<container>> <<atomic>> [
**Edge**
""[container]""
]
rectangle shop.web.frontend <<Angular>> <<container>> <<atomic>> [
**Frontend**
""[container: Angular]""
]
rectangle shop.web.session <<Redis>> <<container>> <<atomic>> [
**Session Store**
""[container: Redis]""
]
}
}
shop.web.api --> mailer : notifies through\n""[SMTP]""
shop.web.api --> shop.catalog : queries\n""[gRPC]""
shop.web.api --> shop.web.session
shop.web.edge --> shop.web.api : routes to\n""[HTTP]""
shop.web.frontend --> shop.web.api : calls\n""[REST]""
