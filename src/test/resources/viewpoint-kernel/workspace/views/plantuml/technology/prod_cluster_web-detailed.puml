@startuml prod_cluster_web-detailed
title Node - web namespace - Detailed View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle prod as "**Production**\n""[environment]""" <<composite>> {
rectangle prod.cluster as "**Kubernetes Cluster**\n""[node: K8s]""" <<composite>> <<K8s>> {
rectangle prod.cluster.data <<atomic>> <<node>> [
**data namespace**
""[node]""
]
rectangle prod.cluster.web as "**web namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.web.pod-a <<atomic>> <<node>> [
**frontend pod**
""[node]""
]
rectangle prod.cluster.web.pod-b <<atomic>> <<node>> [
**api pod**
""[node]""
]
}
}
}
rectangle psp <<environment>> <<atomic>> [
**Payment Provider Cloud**
""[environment]""
]
prod.cluster.web.pod-a --> prod.cluster.web.pod-b : forwards to\n""[HTTP]""
prod.cluster.web.pod-b --> prod.cluster.data : uses\n""[gRPC]""
prod.cluster.web.pod-b --> psp : uses\n""[HTTPS]""
