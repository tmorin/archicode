@startuml prod_cluster_data_svc-deep
title Node - catalog pod - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle prod as "**Production**\n""[environment]""" <<composite>> {
rectangle prod.cluster as "**Kubernetes Cluster**\n""[node: K8s]""" <<composite>> <<K8s>> {
rectangle prod.cluster.data as "**data namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.data.pg as "**database pod**\n""[node]""" <<composite>> {
rectangle pg_shop_catalog_db <<container>> <<PostgreSQL>> <<atomic>> [
**Catalog Database**
""[container: PostgreSQL]""
]
}
rectangle prod.cluster.data.svc as "**catalog pod**\n""[node]""" <<composite>> {
rectangle svc_shop_catalog_service <<Quarkus>> <<container>> <<atomic>> [
**Catalog Service**
""[container: Quarkus]""
]
}
}
rectangle prod.cluster.web as "**web namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.web.pod-b as "**api pod**\n""[node]""" <<composite>> {
rectangle pod-b_shop_web_api <<container>> <<atomic>> <<Spring Boot>> [
**API**
""[container: Spring Boot]""
]
}
}
}
}
svc_shop_catalog_service --> pg_shop_catalog_db : reads and writes\n""[JDBC]""
pod-b_shop_web_api --> svc_shop_catalog_service : queries\n""[gRPC]""
prod.cluster.data.svc --> prod.cluster.data.pg : ""[TCP:5432]""
prod.cluster.web.pod-b --> prod.cluster.data.svc : ""[gRPC]""
