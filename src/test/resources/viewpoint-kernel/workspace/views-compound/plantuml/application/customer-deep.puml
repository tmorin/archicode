@startuml customer-deep
title Person - Customer - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
person customer <<atomic>> <<person>> [
**Customer**
""[person]""

Someone who buys things.
]
rectangle mailer <<system>> <<external>> <<atomic>> [
**Mail Provider**
""[system]""

Sends the e-mails.
]
rectangle shop as "**Online Shop**\n""[solution]""" <<composite>> {
rectangle shop.web as "**Web Shop**\n""[system]""" <<composite>> {
rectangle shop.web.edge as "**Edge**\n""[group]""" <<composite>> {
rectangle shop.web.edge.gateway <<Envoy>> <<container>> <<atomic>> [
**Gateway**
""[container: Envoy]""
]
}
rectangle shop.web.frontend <<Angular>> <<container>> <<atomic>> [
**Frontend**
""[container: Angular]""
]
}
}
customer --> shop.web.edge.gateway : ""[HTTPS]""
customer --> shop.web.frontend : browses with\n""[HTTPS]""
mailer --> customer : sends e-mails to\n""[SMTP]""
