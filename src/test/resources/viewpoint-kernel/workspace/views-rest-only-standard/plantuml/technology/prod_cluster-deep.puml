@startuml prod_cluster-deep
title Node - Kubernetes Cluster - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle prod as "**Production**\n""[environment]""" <<composite>> {
rectangle prod.cluster as "**Kubernetes Cluster**\n""[node: K8s]""" <<composite>> <<K8s>> {
rectangle prod.cluster.data as "**data namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.data.pg <<atomic>> <<node>> [
**database pod**
""[node]""
]
rectangle prod.cluster.data.svc <<atomic>> <<node>> [
**catalog pod**
""[node]""
]
}
rectangle prod.cluster.web as "**web namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.web.pod-a as "**frontend pod**\n""[node]""" <<composite>> {
rectangle pod-a_shop_web_frontend <<Angular>> <<container>> <<atomic>> [
**Frontend**
""[container: Angular]""
]
}
rectangle prod.cluster.web.pod-b as "**api pod**\n""[node]""" <<composite>> {
rectangle pod-b_shop_web_api <<container>> <<atomic>> <<Spring Boot>> [
**API**
""[container: Spring Boot]""
]
}
}
}
}
rectangle psp as "**Payment Provider Cloud**\n""[environment]""" <<composite>> {
rectangle psp.gateway <<atomic>> <<node>> [
**Provider Gateway**
""[node]""
]
}
pod-a_shop_web_frontend --> pod-b_shop_web_api : calls\n""[REST]""
prod.cluster.data.svc --> prod.cluster.data.pg : ""[TCP:5432]""
prod.cluster.web.pod-a --> prod.cluster.web.pod-b : forwards to\n""[HTTP]""
prod.cluster.web.pod-b --> prod.cluster.data.svc : ""[gRPC]""
prod.cluster.web.pod-b --> psp.gateway : pays through\n""[HTTPS]""
