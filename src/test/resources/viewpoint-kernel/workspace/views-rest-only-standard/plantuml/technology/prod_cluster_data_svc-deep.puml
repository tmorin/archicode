@startuml prod_cluster_data_svc-deep
title Node - catalog pod - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle prod as "**Production**\n""[environment]""" <<composite>> {
rectangle prod.cluster as "**Kubernetes Cluster**\n""[node: K8s]""" <<K8s>> <<composite>> {
rectangle prod.cluster.data as "**data namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.data.pg <<node>> <<atomic>> [
**database pod**
""[node]""
]
rectangle prod.cluster.data.svc <<node>> <<atomic>> [
**catalog pod**
""[node]""
]
}
rectangle prod.cluster.web as "**web namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.web.pod-b <<node>> <<atomic>> [
**api pod**
""[node]""
]
}
}
}
prod.cluster.data.svc --> prod.cluster.data.pg : ""[TCP:5432]""
prod.cluster.web.pod-b --> prod.cluster.data.svc : ""[gRPC]""
<style>
.external {
actor {
BackgroundColor: lightgray
}
}
</style>
