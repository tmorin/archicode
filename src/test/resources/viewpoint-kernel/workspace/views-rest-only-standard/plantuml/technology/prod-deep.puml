@startuml prod-deep
title Environment - Production - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle prod as "**Production**\n""[environment]""" <<composite>> {
rectangle prod.cluster as "**Kubernetes Cluster**\n""[node: K8s]""" <<K8s>> <<composite>> {
rectangle prod.cluster.data as "**data namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.data.pg <<node>> <<atomic>> [
**database pod**
""[node]""
]
rectangle prod.cluster.data.svc <<node>> <<atomic>> [
**catalog pod**
""[node]""
]
}
rectangle prod.cluster.web as "**web namespace**\n""[node]""" <<composite>> {
rectangle prod.cluster.web.pod_a as "**frontend pod**\n""[node]""" <<composite>> {
rectangle pod_a_shop_web_frontend <<Angular>> <<container>> <<atomic>> [
**Frontend**
""[container: Angular]""
]
}
rectangle prod.cluster.web.pod_b as "**api pod**\n""[node]""" <<composite>> {
rectangle pod_b_shop_web_api <<Spring Boot>> <<container>> <<atomic>> [
**API**
""[container: Spring Boot]""
]
}
}
}
}
rectangle psp as "**Payment Provider Cloud**\n""[environment]""" <<composite>> {
rectangle psp.gateway <<node>> <<atomic>> [
**Provider Gateway**
""[node]""
]
}
pod_a_shop_web_frontend --> pod_b_shop_web_api : calls\n""[REST]""
prod.cluster.data.svc --> prod.cluster.data.pg : ""[TCP:5432]""
prod.cluster.web.pod_a --> prod.cluster.web.pod_b : forwards to\n""[HTTP]""
prod.cluster.web.pod_b --> prod.cluster.data.svc : ""[gRPC]""
prod.cluster.web.pod_b --> psp.gateway : pays through\n""[HTTPS]""
