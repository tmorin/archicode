@startuml shop_catalog_service-deep
title Container - Catalog Service - Deep View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
rectangle mailer <<system>> <<external>> <<atomic>> [
**Mail Provider**
""[system]""

Sends the e-mails.
]
rectangle shop as "**Online Shop**\n""[solution]""" <<composite>> {
rectangle shop.catalog as "**Catalog**\n""[system]""" <<composite>> {
rectangle shop.catalog.db <<container>> <<PostgreSQL>> <<atomic>> [
**Catalog Database**
""[container: PostgreSQL]""
]
rectangle shop.catalog.service as "**Catalog Service**\n""[container: Quarkus]""" <<composite>> <<Quarkus>> {
rectangle shop.catalog.service.indexer <<component>> <<atomic>> [
**Indexer**
""[component]""
]
rectangle shop.catalog.service.search <<component>> <<atomic>> [
**Search**
""[component]""
]
}
}
rectangle shop.web as "**Web Shop**\n""[system]""" <<composite>> {
rectangle shop.web.api <<container>> <<atomic>> <<Spring Boot>> [
**API**
""[container: Spring Boot]""
]
}
}
shop.catalog.service.indexer --> mailer : reports to
shop.catalog.service.indexer --> shop.catalog.db : reads\n""[JDBC]""
shop.catalog.service.search --> shop.catalog.db : reads\n""[JDBC]""
shop.catalog.service --> shop.catalog.db : reads and writes\n""[JDBC]""
shop.web.api --> shop.catalog.service : queries\n""[gRPC]""
<style>
.external {
actor {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
card {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
database {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
node {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
person {
BackgroundColor: lightgray
}
}
</style>
<style>
.external {
rectangle {
BackgroundColor: lightgray
}
}
</style>
@enduml
