@startuml shop_web-detailed
title System - Web Shop - Detailed View
skinparam defaultTextAlignment center
skinparam defaultTextAlignment<<atomic>> center
skinparam wrapWidth 200
skinparam maxMessageSize 150
hide stereotype
<style>
.composite {
BackgroundColor: transparent
LineColor: darkgray
LineStyle: 5
FontStyle: normal
}
</style>
person customer <<person>> <<atomic>> [
**Customer**
""[person]""

Someone who buys things.
]
rectangle mailer <<external>> <<changed>> <<system>> <<atomic>> [
**Mail Provider**
""[system]""

Sends the e-mails.
]
rectangle shop as "**Online Shop**\n""[solution]""" <<composite>> {
rectangle shop.catalog <<system>> <<atomic>> [
**Catalog**
""[system]""

What is for sale.
]
rectangle shop.payments <<external>> <<system>> <<atomic>> [
**Payment Provider**
""[system]""

Takes the money.
]
rectangle shop.web as "**Web Shop**\n""[system]""" <<composite>> {
rectangle shop.web.api <<Spring Boot>> <<container>> <<atomic>> [
**API**
""[container: Spring Boot]""
]
rectangle shop.web.edge <<group>> <<atomic>> [
**Edge**
""[group]""
]
rectangle shop.web.frontend <<Angular>> <<container>> <<atomic>> [
**Frontend**
""[container: Angular]""
]
rectangle shop.web.session <<Redis>> <<container>> <<atomic>> [
**Session Store**
""[container: Redis]""
]
}
}
customer --> shop.web.edge : uses\n""[HTTPS]""
customer --> shop.web.frontend : browses with\n""[HTTPS]""
shop.web.api --> mailer : notifies through\n""[SMTP]""
shop.web.api --> shop.catalog : queries\n""[gRPC]""
shop.web.api --> shop.payments : charges with\n""[HTTPS]""
shop.web.api --> shop.web.session
shop.web.frontend --> shop.web.api : calls\n""[REST]""
